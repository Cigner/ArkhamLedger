# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Host is the compose service name; use 127.0.0.1 when running outside Docker.
DATABASE_URL=mysql://arkham:change-me@db:3306/arkham?charset=utf8mb4
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=arkham
MYSQL_USER=arkham
MYSQL_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# openssl rand -base64 32   — rotating this invalidates every active session.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cryptography
# ---------------------------------------------------------------------------
# openssl rand -base64 32   — AES-256-GCM key for integration secrets at rest.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------
# Comma-separated public origins. Server Action CSRF checks compare Origin
# against this list; a wrong value breaks every mutation behind the proxy.
ALLOWED_ORIGINS=localhost:3000
# openssl rand -base64 32   — keeps Server Action ids stable across restarts.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Mail (OMV SMTP relay)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Arkham Ledger <no-reply@example.local>"
SMTP_SECURE=false
# Require STARTTLS when using a submission port such as 587.
SMTP_REQUIRE_TLS=false
# Keep true unless the private relay deliberately uses a self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Set when SMTP_HOST is an IP address but the certificate names a DNS host.
SMTP_TLS_SERVERNAME=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Seeding (first administrator only; every other account is created in-app)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info
DEFAULT_TIMEZONE=Europe/Warsaw
TZ=UTC
