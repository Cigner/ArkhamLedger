{
  "name": "arkham-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Session scheduling for tabletop Call of Cthulhu campaigns",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node dist-worker/worker.js",
    "worker:dev": "tsx --conditions=react-server watch src/worker/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server src/db/seed/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.9.1",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.45.0",
    "mysql2": "3.24.4",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "next-safe-action": "8.7.3",
    "nodemailer": "10.0.9",
    "pino": "10.3.1",
    "rate-limiter-flexible": "11.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "1.0.5",
    "tw-animate-css": "^1.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/mysql": "12.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "jsdom": "29.1.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
